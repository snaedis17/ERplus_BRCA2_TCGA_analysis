# ============================================================
13_DESEQ2_3-GROUP_ANALYSIS
# ============================================================
#
# PURPOSE:
# This script performs differential gene expression analysis in ER-positive breast cancer
# using a 3-group design to investigate the relationship between BRCA2-mutated tumors
# and age-associated transcriptional programs.
#
# BIOLOGICAL QUESTIONS:
#
# 1. Do BRCA2-mutated ER+ tumors resemble a "young-like" transcriptional state?
#    → Compare: Mut_All vs WT_Young
#
# 2. What distinguishes BRCA2-mutated tumors from a stable baseline?
#    → Compare: Mut_All vs WT_Old
#
# 3. What defines the age-associated transcriptional program in ER+ tumors?
#    → Compare: WT_Young vs WT_Old
#
# RATIONALE:
# Instead of splitting BRCA2-mutated tumors by age (low power), all BRCA2-mut samples
# are grouped together (Mut_All).
#
# WT_Old is used as a stable baseline reference group.
#


rm(list = ls())

RUN_DESEQ <- TRUE   # TRUE first run, then FALSE

suppressPackageStartupMessages({
  library(DESeq2)
  library(dplyr)
  library(edgeR)
  library(AnnotationDbi)
  library(EnsDb.Hsapiens.v86)
  library(ggplot2)
  library(ggrepel)
  library(ggVennDiagram)
})

filter  <- dplyr::filter
select  <- dplyr::select
mutate  <- dplyr::mutate
arrange <- dplyr::arrange

# ------------------------------------------------------------
# PATHS
# ------------------------------------------------------------
results_dir <- "results/brca2_threegroup"
dir.create(results_dir, recursive = TRUE, showWarnings = FALSE)

# ============================================================
# PART 1 — BUILD DESEQ OBJECT
# ============================================================
if (RUN_DESEQ) {
  
  counts <- readRDS("data/counts_ERpos_clean_final.rds")
  annot  <- readRDS("data/annot_ERpos_clean_final.rds")
  
  annot <- annot %>%
    mutate(
      age = case_when(
        !is.na(age_num) ~ age_num,
        !is.na(age_at_index) ~ age_at_index,
        TRUE ~ NA_real_
      ),
      age = if_else(age > 90, 90, age),
      age_group = if_else(age <= 40, "Young", "Old"),
      BRCA2_Status = factor(BRCA2_Status, levels = c("WT","Mut")),
      
      grp3 = case_when(
        BRCA2_Status == "WT" & age_group == "Old"   ~ "WT_Old",
        BRCA2_Status == "WT" & age_group == "Young" ~ "WT_Young",
        BRCA2_Status == "Mut"                      ~ "Mut_All"
      ),
      
      grp3 = factor(grp3, levels = c("WT_Old","WT_Young","Mut_All"))
    ) %>%
    filter(!is.na(grp3))
  
  counts <- counts[, annot$patient12]
  
  # ------------------------------------------------------------
  # KEEP ONLY PROTEIN-CODING GENES (SAFE)
  # ------------------------------------------------------------
  gene_ids <- gsub("\\..*", "", rownames(counts))
  
  gene_annot <- AnnotationDbi::select(
    EnsDb.Hsapiens.v86,
    keys = gene_ids,
    keytype = "GENEID",
    columns = c("GENEBIOTYPE")
  )
  
  gene_annot <- gene_annot[match(gene_ids, gene_annot$GENEID), ]
  
  keep_pc <- !is.na(gene_annot$GENEBIOTYPE) &
    gene_annot$GENEBIOTYPE == "protein_coding"
  
  counts <- counts[keep_pc, ]
  
  cat("Protein-coding genes kept:", nrow(counts), "\n")
  
  # ------------------------------------------------------------
  # LOW EXPRESSION FILTER
  # ------------------------------------------------------------
  keep <- rowSums(counts >= 10) >= 5
  counts <- counts[keep, ]
  
  cat("Genes kept after filtering:", nrow(counts), "\n")
  
  # ------------------------------------------------------------
  # DESEQ2
  # ------------------------------------------------------------
  dds <- DESeqDataSetFromMatrix(
    countData = counts,
    colData   = annot,
    design    = ~ grp3
  )
  
  dds <- DESeq(dds)
  
  saveRDS(dds, file.path(results_dir, "dds_grp3.rds"))
  
  cat("\nDESeq2 finished and saved\n")
}

# ============================================================
# PART 2 — LOAD
# ============================================================
dds <- readRDS(file.path(results_dir, "dds_grp3.rds"))
cat("\nLoaded DESeq object\n")

# ============================================================
# CONTRASTS
# ============================================================
res_list_raw <- list(
  WTYoung_vs_WTOld = results(dds, contrast = c("grp3","WT_Young","WT_Old")),
  MutAll_vs_WTOld  = results(dds, contrast = c("grp3","Mut_All","WT_Old")),
  MutAll_vs_WTYoung = results(dds, contrast = c("grp3","Mut_All","WT_Young"))
)

# ============================================================
# SHRINKAGE
# ============================================================
res_list_shrunk <- list(
  WTYoung_vs_WTOld = lfcShrink(dds, coef = "grp3_WT_Young_vs_WT_Old", type = "apeglm"),
  MutAll_vs_WTOld  = lfcShrink(dds, coef = "grp3_Mut_All_vs_WT_Old", type = "apeglm"),
  MutAll_vs_WTYoung = lfcShrink(dds, contrast = c("grp3","Mut_All","WT_Young"), type = "ashr")
)

# ============================================================
# ANNOTATION
# ============================================================
add_symbols <- function(res_obj) {
  df <- as.data.frame(res_obj)
  df$ENSEMBL <- gsub("\\..*", "", rownames(df))
  
  df$SYMBOL <- mapIds(
    EnsDb.Hsapiens.v86,
    keys = df$ENSEMBL,
    keytype = "GENEID",
    column = "SYMBOL",
    multiVals = "first"
  )
  
  df %>% relocate(SYMBOL, ENSEMBL)
}

res_list_raw    <- lapply(res_list_raw, add_symbols)
res_list_shrunk <- lapply(res_list_shrunk, add_symbols)

# ============================================================
# SAVE RESULTS
# ============================================================
for(name in names(res_list_raw)) {
  saveRDS(res_list_raw[[name]],
          file.path(results_dir, paste0("res_", name, "_RAW.rds")))
  
  saveRDS(res_list_shrunk[[name]],
          file.path(results_dir, paste0("res_", name, "_SHRUNK.rds")))
}

# ============================================================
# VOLCANO
# ============================================================
plot_volcano <- function(res_df, title, filename) {
  
  df <- as.data.frame(res_df)  
  
  df <- df %>%
    filter(!is.na(padj), !is.na(log2FoldChange)) %>%
    mutate(
      neglog10 = -log10(padj),
      direction = case_when(
        padj < 0.05 & log2FoldChange > 1  ~ "Up",
        padj < 0.05 & log2FoldChange < -1 ~ "Down",
        TRUE ~ "NS"
      )
    )
  
  p <- ggplot(df, aes(log2FoldChange, neglog10)) +
    geom_point(aes(color = direction), alpha = 0.7) +
    scale_color_manual(values = c("Up"="#d73027","Down"="#4575b4","NS"="grey80")) +
    geom_vline(xintercept = c(-1,1), linetype="dashed") +
    geom_hline(yintercept = -log10(0.05), linetype="dashed") +
    theme_bw(base_size=14) +
    labs(title=title, x="log2 fold change", y="-log10 adjusted p-value")
  
  print(p)
  
  ggsave(file.path(results_dir, filename), p, width=6, height=5, dpi=300)
}

# ------------------------------------------------------------
# WT AGE EFFECT
# ------------------------------------------------------------
plot_volcano(res_list_shrunk$WTYoung_vs_WTOld, 
             "WT Young vs WT Old (shrunk)", 
             "volcano_WT_age_SHRUNK.png")

plot_volcano(res_list_raw$WTYoung_vs_WTOld, 
             "WT Young vs WT Old (RAW)", 
             "volcano_WT_age_RAW.png")

# ------------------------------------------------------------
# BRCA2 EFFECT (vs OLD baseline)
# ------------------------------------------------------------
plot_volcano(res_list_shrunk$MutAll_vs_WTOld, 
             "Mut vs WT Old (shrunk)", 
             "volcano_Mut_vs_WTOld_SHRUNK.png")

plot_volcano(res_list_raw$MutAll_vs_WTOld, 
             "Mut vs WT Old (RAW)", 
             "volcano_Mut_vs_WTOld_RAW.png")

# ------------------------------------------------------------
# BRCA2 vs YOUNG (KEY biological question)
# ------------------------------------------------------------
plot_volcano(res_list_shrunk$MutAll_vs_WTYoung, 
             "Mut vs WT Young (shrunk)", 
             "volcano_Mut_vs_WTYoung_SHRUNK.png")

plot_volcano(res_list_raw$MutAll_vs_WTYoung, 
             "Mut vs WT Young (RAW)", 
             "volcano_Mut_vs_WTYoung_RAW.png")

# ============================================================
# DEG EXTRACTION
# ============================================================
get_deg <- function(res_df) {
  df <- as.data.frame(res_df)
  
  df %>%
    filter(
      !is.na(padj),
      padj < 0.05,
      abs(log2FoldChange) >= 1,
      !is.na(SYMBOL),
      SYMBOL != ""
    ) %>%
    pull(SYMBOL) %>%
    unique()
}

deg_WT  <- get_deg(res_list_raw$WTYoung_vs_WTOld)
deg_MO  <- get_deg(res_list_raw$MutAll_vs_WTOld)
deg_MY  <- get_deg(res_list_raw$MutAll_vs_WTYoung)

# WT age 
#Up: 74 
#Down: 598 

# Mut vs WT Old 
#Up: 38 
#Down: 365 

# Mut vs WT Young 
#Up: 19 
#Down: 30 
# ============================================================
# VENN
# ============================================================
venn_list <- list(WT_age=deg_WT, Mut_vs_WTOld=deg_MO, Mut_vs_WTYoung=deg_MY)

p_venn <- ggVennDiagram(venn_list) + theme_void()
print(p_venn)

ggsave(file.path(results_dir,"venn.png"), p_venn)

# ============================================================
# COUNTS
# ============================================================
count_deg <- function(res_df, name) {
  
  df <- as.data.frame(res_df)
  
  up <- df %>% filter(!is.na(padj), padj < 0.05, log2FoldChange > 1)
  down <- df %>% filter(!is.na(padj), padj < 0.05, log2FoldChange < -1)
  
  cat("\n", name, "\n")
  cat("Up:", nrow(up), "\n")
  cat("Down:", nrow(down), "\n")
}

count_deg(res_list_raw$WTYoung_vs_WTOld, "WT age")
count_deg(res_list_raw$MutAll_vs_WTOld, "Mut vs WT Old")
count_deg(res_list_raw$MutAll_vs_WTYoung, "Mut vs WT Young")

cat("\nDONE\n")
